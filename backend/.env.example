# ==============================================================================
# Shivam Kirana Store - Backend Environment Variables Template
# Copy this file to '.env' and fill in your values for local testing,
# or add these exact environment variables in your Render Dashboard settings.
# ==============================================================================

# General Settings
DEBUG=True
SECRET_KEY=your-django-secret-key-here
ALLOWED_HOSTS=*

# Email / SMTP Configuration (Needed for real-time OTP verification emails)
# For production/Render, set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
# IMPORTANT: Use a Google App Password here, not your regular account password
EMAIL_HOST_PASSWORD=your-google-app-password-16-chars
DEFAULT_FROM_EMAIL=Shivam Kirana Store <no-reply@shivamkiranastore.com>

# Database URL (Render / Production PostgreSQL)
# If blank, defaults to local SQLite db.sqlite3
DATABASE_URL=

# Celery & Redis (Optional local testing)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Online Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Twilio WhatsApp Integration (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
